{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
            "env": {
        "OPENWHISPR_APP_ENV": "production",
        "OPENWHISPR_ANDROID_PACKAGE": "com.twas10.openwhispr",
        "OPENWHISPR_SCHEME": "twas10-openwhispr",
        "OPENWHISPR_DISPLAY_NAME": "OpenWhispr TWAS10",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EAS_BUILD_DISABLE_EXPO_DOCTOR_STEP": "true"
      }
    },
    "production": {}
  },
  "submit": {
    "production": {}
  }
}